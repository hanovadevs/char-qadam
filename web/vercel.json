{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "https://api.stepsyapp.com/admin/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.stepsyapp.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
