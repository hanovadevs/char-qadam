[Unit]
Description=Qadam API
After=network-online.target
Wants=network-online.target

[Service]
User=qadam
Group=qadam
WorkingDirectory=/opt/qadam/backend
EnvironmentFile=/etc/qadam/backend.env
Environment=WEB_CONCURRENCY=2
ExecStart=/opt/qadam/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers ${WEB_CONCURRENCY} --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 5 --limit-concurrency 200
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
