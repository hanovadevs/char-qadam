# Stepsy API Environment Configuration Template
# Copy to .env and fill in real values. Never commit the real .env to git.

APP_NAME=Stepsy API
ENVIRONMENT=development # Set to "production" in production deployments
DEBUG=true              # Automatically forced to false in production

# CORS: Comma-separated list of allowed origins or "*" for development
CORS_ORIGINS=*

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stepsy

# Points engine (server-side rule)
STEPS_PER_POINT=100
DAILY_STEP_CAP=20000

# Vouchers
VOUCHER_VALIDITY_DAYS=30

# JWT Authentication
# Generate in terminal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production: use explicit HTTPS origins, ENVIRONMENT=production, DEBUG=false.
# Set unique credentials before starting the production service.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-random-password
# Pool sizes are PER WORKER. Two workers use at most 20 DB connections here.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_COMMAND_TIMEOUT=15
# Supabase production TLS (leave unset for a local non-TLS development DB).
# DB_SSL_CA_FILE=certs/supabase-ca.crt

# AI support is optional and disabled until explicitly enabled in the admin UI.
# Keep this key server-side. Set OpenAI project spending/rate limits as well.
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
