# Stepsy API Environment Configuration Template
# Copy to .env and fill in real values. Never commit the real .env to git.

APP_NAME=Stepsy API
ENVIRONMENT=development # Set to "production" in production deployments
DEBUG=true              # Automatically forced to false in production

# CORS: Comma-separated list of allowed origins or "*" for development
CORS_ORIGINS=*

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stepsy

# Points engine (server-side rule)
STEPS_PER_POINT=100
DAILY_STEP_CAP=20000

# Vouchers
VOUCHER_VALIDITY_DAYS=30

# JWT Authentication
# Generate in terminal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin portal (set a unique password before deploying)
ADMIN_EMAIL=admin@stepsy.app
ADMIN_PASSWORD=

# Password reset email delivery (587 + STARTTLS, or 465 + SMTP_USE_SSL=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
