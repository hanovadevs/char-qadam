# Copy to .env and fill in real values. Never commit the real .env.
APP_NAME=Qadam API
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string (async driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://qadam:qadam@localhost:5432/qadam

# Points engine (server-side rule — change without an app release)
STEPS_PER_POINT=100
DAILY_STEP_CAP=20000

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600
